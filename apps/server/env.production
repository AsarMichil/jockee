# =============================================================================
# Auto-DJ Server - Production Environment Configuration for Render
# =============================================================================
# Copy these values to your Render Web Service Environment Variables
# 
# 🚀 Quick Setup:
# 1. Create your Render Blueprint from render.yaml
# 2. Set these environment variables in Render Dashboard
# 3. Deploy!
#
# 💡 Variables marked with [REQUIRED] must be set for the app to work
# 💡 Variables marked with [AUTO] are set automatically by Render
# =============================================================================

# Environment Configuration
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
# PORT=[AUTO] - Render sets this automatically

# Security [REQUIRED] - Generate a strong secret key for production
SECRET_KEY=your-super-secret-key-change-this-in-production-make-it-long-and-random-64-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database [REQUIRED] - Use your Supabase PostgreSQL connection string
# Example: postgresql://postgres.xyz:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://username:password@host:port/database

# Redis [AUTO] - These are set automatically by the render.yaml blueprint
# REDIS_URL=redis://red-xyz123:password@host:port
# CELERY_BROKER_URL=redis://red-xyz123:password@host:port  
# CELERY_RESULT_BACKEND=redis://red-xyz123:password@host:port

# Spotify API [REQUIRED] - Get from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# Update this with your actual Render service URL after deployment
SPOTIFY_REDIRECT_URI=https://your-app-name.onrender.com/api/v1/auth/spotify/callback

# AWS S3 Configuration [REQUIRED] - For audio file storage
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-s3-bucket-name
CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net

# Audio Storage - Ephemeral filesystem (limited use on Render)
AUDIO_STORAGE_PATH=/tmp/audio
MAX_AUDIO_CACHE_GB=5

# yt-dlp settings - Reduced for production to avoid rate limits
YTDL_RATE_LIMIT=1M
YTDL_MAX_DOWNLOADS_PER_MINUTE=30

# CORS [REQUIRED] - Update with your frontend domains
# Example: https://your-frontend.com,https://another-domain.com
CORS_ORIGINS=https://your-frontend-domain.com,https://your-app-name.onrender.com

# =============================================================================
# 📝 Notes for Production Setup:
# =============================================================================
# 
# 1. SECRET_KEY: Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# 
# 2. DATABASE_URL: Get from Supabase → Settings → Database → Connection String
#    Format: postgresql://postgres.xyz:[PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres
# 
# 3. Spotify API: Create app at https://developer.spotify.com/dashboard
#    - Set redirect URI to: https://your-app-name.onrender.com/api/v1/auth/spotify/callback
#    - Add both local and production URLs for development
# 
# 4. AWS S3: Create S3 bucket and CloudFront distribution for audio files
#    - Bucket should be private, accessed only through CloudFront
#    - IAM user needs s3:PutObject, s3:GetObject, s3:DeleteObject permissions
# 
# 5. CORS_ORIGINS: Include all domains that will access your API
#    - Your frontend domain(s)  
#    - Your Render app domain for Swagger docs
# 
# ============================================================================= 